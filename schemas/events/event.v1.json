{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbita.sovereign/schemas/events/v1/event.json",
  "title": "ORBITA Operational Event",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "severity",
    "timestamp"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "event_type": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "critical"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true
}
